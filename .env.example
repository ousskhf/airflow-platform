# Copy to .env and fill the empty values. Never commit .env.

# Host user and docker group, so the containers can use the Docker socket.
#   id -u            -> UID
#   getent group docker | cut -d: -f3   -> DOCKER_GID
UID=1000
DOCKER_GID=999

# Absolute path of the folder that holds your projects (used by docker-compose.projects.yml).
PROJECTS_DIR=/path/to/your/projects

# Only needed with docker-compose.tailscale.yml: extra interface to publish the UI on.
TAILSCALE_IP=

# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=
AIRFLOW_SECRET_KEY=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=
